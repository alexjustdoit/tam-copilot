# LLM Provider Selection
# true = use Ollama (free, local) | false = use API providers
USE_LOCAL_LLM=true

# Ollama (local) — only needed if USE_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI — only needed if USE_LOCAL_LLM=false
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-nano

# Anthropic (Claude) — optional, used for quality-required tasks when USE_LOCAL_LLM=false
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001
